rules_version = '2';

// Firestore security rules for jpnote-1bdd6
//
// 部署方式（選一）：
//   A. Firebase Console → Firestore Database → Rules → 貼上此檔內容 → 發布
//   B. Firebase CLI: `firebase deploy --only firestore:rules`
//      （需先 `firebase init firestore` 關聯 project jpnote-1bdd6）

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin 判定:白名單 email + 必須已驗證(email_verified)。
    // 沒有 email_verified 的話,若專案哪天開了 Email/Password provider,
    // 有人用同名 email 註冊未驗證帳號就能冒充 admin → 全站個資淪陷。加這道防線擋死。
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'];
    }


    // 使用者私人資料（收藏 / 學習進度 / 複習資料 / 訂閱狀態）
    // 結構：users/{uid} → { favorites, quiz_history, srs_data, subscription, ... }
    // owner 可讀寫自己;admin email 可讀(report / debug 用,不能寫)
    match /users/{userId} {
      allow read: if request.auth != null && (
                    request.auth.uid == userId ||
                    isAdmin()
                  );

      // 推薦碼歸因防竄改:ref_code 只能設成「存在、啟用、未停權、且不是自己的」碼。
      // rules 的 get()/exists() 會繞過 ref_codes 的讀取規則(admin-only),可直接驗證。
      // (同一路徑的 get() 在單次評估內快取,只算一次讀取。)防有人改 console 亂塞碼/停權碼刷分潤。
      function refCodeValidOnSet(code) {
        // 用 .get(key, default) 安全取值：正常啟用的碼沒有 status 欄位(只有停權才寫)，
        // 直接存取不存在的欄位在規則裡會丟錯 → 一律用預設值。
        return code is string
          && exists(/databases/$(database)/documents/ref_codes/$(code))
          && get(/databases/$(database)/documents/ref_codes/$(code)).data.get('active', true) != false
          && get(/databases/$(database)/documents/ref_codes/$(code)).data.get('status', '') != 'suspended'
          && get(/databases/$(database)/documents/ref_codes/$(code)).data.get('owner_uid', '') != userId;
      }
      // 只有在真的改動 ref_code/ref_at/ref_bonus_at 時才做額外檢查:
      //   - ref_bonus_at(首購獎勵鎖旗標)只准 Cloud Function 寫,client 不得設/改
      //   - 改 ref_code 前提:尚未鎖定(未發首購獎);清除 ref_code(登出/更換前)一律允許
      //   - 設 ref_code:必須通過 refCodeValidOnSet
      function refCodeUpdateOk() {
        let d = request.resource.data;
        let changed = d.diff(resource.data).affectedKeys();
        return !changed.hasAny(['ref_code', 'ref_at', 'ref_bonus_at'])
          || ( !changed.hasAny(['ref_bonus_at'])
               && !('ref_bonus_at' in resource.data)
               && ( !('ref_code' in d) || d.ref_code == null || refCodeValidOnSet(d.ref_code) ) );
      }

      // 本人可寫自己的 doc(srs_data/收藏/streak…),但「subscription」「trial_started_at」禁止 client 寫
      // —— 訂閱與試用起始只准 Cloud Function (Admin SDK 繞過規則) 寫,防止有人改 console 自己白嫖 / 重發試用。
      allow create: if request.auth != null && request.auth.uid == userId
                    && !('subscription' in request.resource.data)
                    && !('trial_started_at' in request.resource.data)
                    && !('ref_bonus_at' in request.resource.data)
                    && ( !('ref_code' in request.resource.data)
                         || request.resource.data.ref_code == null
                         || refCodeValidOnSet(request.resource.data.ref_code) );
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'trial_started_at'])
                    && refCodeUpdateOk();

      // AI 情境對話紀錄(speak-chat 保存的逐場對話)— 純學習資料,本人讀寫刪
      match /chat_logs/{logId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 用過試用的 email 記錄(startTrial 後端寫)— client 完全碰不到,防鑽試用。
    match /trial_used/{key} {
      allow read, write: if false;
    }

    // 衝刺計畫預購名單 — sprint.html 登記;一人一筆(docId=uid),admin 可讀
    match /sprint_waitlist/{uid} {
      allow read: if request.auth != null &&
        isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // 衝刺計畫內容 — 每級 meta 一份、每週一份(docId 如 n4_meta / n4_w1)。
    // 由 admin 從 sprint-upload.html 灌入;讀取按權限:免費週(free==true)人人可讀,
    // 其餘週需「訂閱中」或「有衝刺計畫存取權」。避免付費內容外流。
    function sprintEntitled() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subscription', {}).get('status', '') in ['active','trialing','cancelled','lifetime'])
        || exists(/databases/$(database)/documents/sprint_access/$(request.auth.uid))
      );
    }
    match /sprint_content/{docId} {
      allow read: if resource.data.get('free', false) == true || sprintEntitled();
      allow write: if request.auth != null &&
        isAdmin();
    }
    // 衝刺計畫購買者(未來單獨售出時,Cloud Function 寫;現階段訂閱者即解鎖)
    match /sprint_access/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 進度資料(srs_data 等大 blob,各 key gzip bytes)— 從 users/{uid} 搬出,避免撞 1MiB。
    // 本人可讀寫自己;admin 可讀(debug)。無金流欄位,owner 可寫無自封 premium 風險。
    match /user_progress/{uid} {
      allow read: if request.auth != null && (
                    request.auth.uid == uid ||
                    isAdmin()
                  );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 訂閱交易帳本 — Cloud Function 寫,admin + 用戶自己讀
    // 結構:transactions/{txnId} → { uid, type, amount_twd, ... }
    match /transactions/{txnId} {
      allow read: if request.auth != null && (
                    isAdmin() ||
                    resource.data.uid == request.auth.uid
                  );
      allow write: if false;  // 只有 Cloud Function (Admin SDK) 能寫
    }

    // AI 用量(帳號頁「今日額度」顯示用)— 只能讀自己的;只有 Cloud Function 寫
    match /ai_usage/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // AI 額度參數(帳號頁顯示上限用;無敏感內容)
    match /config/ai {
      allow read: if true;
      allow write: if false;
    }

    // 免費制世代切換參數(tool-quota.js 總次數包;無敏感內容)
    // packStartMs=0/文件不存在 = 未啟用,全員維持原每日制
    match /config/quota {
      allow read: if true;
      allow write: if false;
    }

    // 早鳥計數器
    match /counters/{name} {
      allow read: if true;  // 前端 paywall 要顯示「剩 X 名」
      allow write: if false;  // 只 Cloud Function 寫
    }

    // 免費白名單(管理員後台授予)— 文件存在 = 該 uid 免費
    // 用戶只能讀自己的(tool-quota 判斷是否免擋);只有 Cloud Function (Admin SDK) 能寫,
    // 防止用戶自己寫 free_users/{自己uid} 自封免費。
    match /free_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // PayPal 手動付款意向 — 登入用戶點 PayPal 鈕時記錄自己的 {uid,email,plan},
    // owner 對帳/開通用。建立限本人、只有 owner 能讀;不可改/刪。
    match /paypal_pending/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null &&
                     isAdmin();
      allow update, delete: if false;
    }

    // KOL 推薦碼登錄表 — admin 後台建立/管理;KOL 自助查詢走 Cloud Function(Admin SDK)不直接讀
    match /ref_codes/{code} {
      allow read, write: if request.auth != null &&
                     isAdmin();
    }

    // 兌換碼(測試者/活動免費 Premium)— admin 後台管理;兌換的發放走 redeemCode Cloud Function
    match /redeem_codes/{code} {
      allow read, write: if request.auth != null &&
                     isAdmin();
    }
    // 兌換紀錄 — 只 Cloud Function (Admin SDK) 寫,admin 可讀(稽核)
    match /redeem_uses/{id} {
      allow read: if request.auth != null &&
                     isAdmin();
      allow write: if false;
    }

    // 系統告警(每日訂閱稽核結果)— Cloud Function (Admin SDK) 寫,admin 後台讀
    match /system_alerts/{doc} {
      allow read: if request.auth != null &&
                     isAdmin();
      allow write: if false;
    }

    // 黑名單(退費 / chargeback 紀錄)— 用 emailHash 當 doc id
    // 只有 Cloud Function 能讀寫;前端不該知道誰在黑名單
    match /blacklist/{emailHash} {
      allow read: if request.auth != null &&
                     isAdmin();
      allow write: if false;
    }

    // 意見回饋 — contact.html 表單寫入,admin.html 後台讀寫
    // 創建:登入用戶寫自己的(防偽造)
    // 讀/改/刪:僅 owner email = stayjpplan@gmail.com 或 abc83327@gmail.com
    match /feedback/{docId} {
      allow read, update, delete: if
        request.auth != null &&
        isAdmin();
      allow create: if
        request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['type', 'message', 'uid', 'createdAt']) &&
        request.resource.data.type in ['bug', 'feature', 'content', 'other'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 5000;
    }

    // 訪客 streak 雲端備份（已登入用戶）— 結構併入 users/{uid}.streak，不需要獨立規則

    // 公開累積計數器 — home.html 顯示「已有 X 位學員」
    // 客戶端 +1 已停用（吃 Spark 20K 寫/日上限），改由 GitHub Actions cron 用
    // service account 覆寫；前端只讀。SA Admin 寫入會繞過這條 rule。
    match /stats/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // 寄信 queue(Trigger Email 擴充套件用)— cron/擴充套件寫,admin 讀(看板統計今日寄信量)
    match /mail/{docId} {
      allow read: if request.auth != null &&
        isAdmin();
      allow write: if false;   // 只 Cloud Function(Admin SDK)寫,繞過此規則
    }

    // 學習內容主檔 — vocab / grammar / listening / reading / confusables 集中。
    // 前端 + App 都讀同一份；寫入限 SA（migration script 用 JWT）。
    match /content/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ATM 人工退款申請 — Cloud Function(Admin SDK)寫入;admin 後台讀 + 標記已處理。
    match /refund_requests/{id} {
      allow read, write: if isAdmin();
    }

    // KOL 分潤紀錄 — Cloud Function(Admin SDK)寫,admin 後台唯讀對帳/結算
    match /commissions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // KOL 線上簽署領款申請 — 只有 admin 能讀(後台請款清單);建立只走 Admin SDK
    // (kolRequestPayout 函式);admin 僅可改 status/handled_at 標記已處理。不含身分證/地址。
    match /payout_requests/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handled_at']);
      allow create, delete: if false;
    }

    // 預設拒絕：未明確允許的所有路徑皆擋
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
