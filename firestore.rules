rules_version = '2';

// Firestore security rules for jpnote-1bdd6
//
// 部署方式（選一）：
//   A. Firebase Console → Firestore Database → Rules → 貼上此檔內容 → 發布
//   B. Firebase CLI: `firebase deploy --only firestore:rules`
//      （需先 `firebase init firestore` 關聯 project jpnote-1bdd6）

service cloud.firestore {
  match /databases/{database}/documents {

    // 使用者私人資料（收藏 / 學習進度 / 複習資料 / 訂閱狀態）
    // 結構：users/{uid} → { favorites, quiz_history, srs_data, subscription, ... }
    // owner 可讀寫自己;admin email 可讀(report / debug 用,不能寫)
    match /users/{userId} {
      allow read: if request.auth != null && (
                    request.auth.uid == userId ||
                    request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com']
                  );
      // 本人可寫自己的 doc(srs_data/收藏/streak…),但「subscription」與「trial_started_at」禁止 client 寫
      // —— 訂閱與試用起始只准 Cloud Function (Admin SDK 繞過規則) 寫,防止有人改 console 自己白嫖 / 重發試用。
      allow create: if request.auth != null && request.auth.uid == userId
                    && !('subscription' in request.resource.data)
                    && !('trial_started_at' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'trial_started_at']);
    }

    // 用過試用的 email 記錄(startTrial 後端寫)— client 完全碰不到,防鑽試用。
    match /trial_used/{key} {
      allow read, write: if false;
    }

    // 進度資料(srs_data 等大 blob,各 key gzip bytes)— 從 users/{uid} 搬出,避免撞 1MiB。
    // 本人可讀寫自己;admin 可讀(debug)。無金流欄位,owner 可寫無自封 premium 風險。
    match /user_progress/{uid} {
      allow read: if request.auth != null && (
                    request.auth.uid == uid ||
                    request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com']
                  );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 訂閱交易帳本 — Cloud Function 寫,admin + 用戶自己讀
    // 結構:transactions/{txnId} → { uid, type, amount_twd, ... }
    match /transactions/{txnId} {
      allow read: if request.auth != null && (
                    request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'] ||
                    resource.data.uid == request.auth.uid
                  );
      allow write: if false;  // 只有 Cloud Function (Admin SDK) 能寫
    }

    // 早鳥計數器
    match /counters/{name} {
      allow read: if true;  // 前端 paywall 要顯示「剩 X 名」
      allow write: if false;  // 只 Cloud Function 寫
    }

    // 免費白名單(管理員後台授予)— 文件存在 = 該 uid 免費
    // 用戶只能讀自己的(tool-quota 判斷是否免擋);只有 Cloud Function (Admin SDK) 能寫,
    // 防止用戶自己寫 free_users/{自己uid} 自封免費。
    match /free_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // PayPal 手動付款意向 — 登入用戶點 PayPal 鈕時記錄自己的 {uid,email,plan},
    // owner 對帳/開通用。建立限本人、只有 owner 能讀;不可改/刪。
    match /paypal_pending/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null &&
                     request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'];
      allow update, delete: if false;
    }

    // KOL 推薦碼登錄表 — admin 後台建立/管理;KOL 自助查詢走 Cloud Function(Admin SDK)不直接讀
    match /ref_codes/{code} {
      allow read, write: if request.auth != null &&
                     request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'];
    }

    // 系統告警(每日訂閱稽核結果)— Cloud Function (Admin SDK) 寫,admin 後台讀
    match /system_alerts/{doc} {
      allow read: if request.auth != null &&
                     request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'];
      allow write: if false;
    }

    // 黑名單(退費 / chargeback 紀錄)— 用 emailHash 當 doc id
    // 只有 Cloud Function 能讀寫;前端不該知道誰在黑名單
    match /blacklist/{emailHash} {
      allow read: if request.auth != null &&
                     request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'];
      allow write: if false;
    }

    // 意見回饋 — contact.html 表單寫入,admin.html 後台讀寫
    // 創建:登入用戶寫自己的(防偽造)
    // 讀/改/刪:僅 owner email = stayjpplan@gmail.com 或 abc83327@gmail.com
    match /feedback/{docId} {
      allow read, update, delete: if
        request.auth != null &&
        request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'];
      allow create: if
        request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['type', 'message', 'uid', 'createdAt']) &&
        request.resource.data.type in ['bug', 'feature', 'content', 'other'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 5000;
    }

    // 訪客 streak 雲端備份（已登入用戶）— 結構併入 users/{uid}.streak，不需要獨立規則

    // 公開累積計數器 — home.html 顯示「已有 X 位學員」
    // 客戶端 +1 已停用（吃 Spark 20K 寫/日上限），改由 GitHub Actions cron 用
    // service account 覆寫；前端只讀。SA Admin 寫入會繞過這條 rule。
    match /stats/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // 學習內容主檔 — vocab / grammar / listening / reading / confusables 集中。
    // 前端 + App 都讀同一份；寫入限 SA（migration script 用 JWT）。
    match /content/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ATM 人工退款申請 — Cloud Function(Admin SDK)寫入;admin 後台讀 + 標記已處理。
    match /refund_requests/{id} {
      allow read, write: if request.auth != null &&
                    request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'];
    }

    // KOL 分潤紀錄 — Cloud Function(Admin SDK)寫,admin 後台唯讀對帳/結算
    match /commissions/{id} {
      allow read: if request.auth != null &&
                    request.auth.token.email in ['stayjpplan@gmail.com', 'abc83327@gmail.com'];
      allow write: if false;
    }

    // 預設拒絕：未明確允許的所有路徑皆擋
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
