{
  "name": "stay-jp-notes",
  "version": "1.0.0",
  "private": true,
  "description": "StayJP Study — JLPT N5–N1 備考工具",
  "scripts": {
    "validate": "node scripts/validate.js",
    "check-readings": "node scripts/check-readings.js",
    "tts:collect": "node scripts/tts/collect.mjs",
    "tts:generate": "node scripts/tts/generate.mjs",
    "tts:audit": "node scripts/tts/audit-pronunciation.mjs",
    "tts:google": "node scripts/tts/gen-google.mjs --voice all",
    "tts:google:qa": "node scripts/tts/qa-google.mjs --voice all",
    "tts:google:upload": "sh scripts/tts/upload-google-r2-fast.sh leda 4 && sh scripts/tts/upload-google-r2-fast.sh charon 4",
    "tts": "node scripts/tts/collect.mjs && node scripts/tts/generate.mjs",
    "usage:generate": "node scripts/usage/generate.mjs"
  },
  "dependencies": {
    "kuromoji": "^0.1.2"
  }
}
