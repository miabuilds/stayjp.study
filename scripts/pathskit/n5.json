{"i": 0, "bg": "skit-shrine.jpg", "title": {"zh": "狸太郎到日本", "en": "Tanuki arrives in Japan", "ko": "타누키, 일본에 도착하다"}, "intro": {"zh": "狸太郎第一次到日本,在神社前遇到一隻狐狸。", "en": "On his first trip to Japan, Tanuki meets a fox in front of a shrine.", "ko": "처음 일본에 온 타누키가 신사 앞에서 여우를 만납니다."}, "start": ["tanuki-travel", "fox-stand"], "end": ["tanuki-yatta", "fox-laugh"], "used": ["皆さん", "あなた", "子供", "僕", "私"], "lines": [{"who": "t", "j": "皆さん、こんにちは！", "pose": ["tanuki-bye", "fox-stand"], "emo": {"t": "♪"}, "zh": "大家好！", "en": "Hello, everyone!", "ko": "여러분, 안녕하세요!"}, {"who": "k", "j": "あなたは、<em>子供ですか</em>？", "pose": ["tanuki-question", "fox-point"], "emo": {"k": "?"}, "zh": "你是……小孩嗎？", "en": "Are you… a kid?", "ko": "당신은… 어린이예요?"}, {"who": "t", "j": "<em>子供じゃありません</em>！僕は<em>たぬきです</em>。", "pose": ["tanuki-angry", "fox-surprise"], "emo": {"k": "!"}, "zh": "我不是小孩！我是狸貓。", "en": "I'm not a kid! I'm a tanuki.", "ko": "어린이가 아니에요! 저는 너구리예요."}, {"who": "k", "j": "私は<em>コンです</em>。<em>きつねです</em>。", "pose": ["tanuki-surprise", "fox-talk"], "emo": {"t": "!"}, "zh": "我是コン。我是狐狸。", "en": "I'm Kon. I'm a fox.", "ko": "저는 콘이에요. 여우예요."}, {"who": "t", "j": "よろしくお願いします！", "pose": ["tanuki-bow", "fox-bye"], "emo": {"k": "♪"}, "zh": "請多多指教！", "en": "Nice to meet you!", "ko": "잘 부탁드립니다!"}], "eg": [{"j": "彼は<em>子供です</em>。", "w": ["彼", "子供"], "zh": "他是小孩。", "en": "He is a child.", "ko": "그는 어린이예요."}, {"j": "彼女は<em>子供じゃありません</em>。", "w": ["彼女", "子供"], "zh": "她不是小孩。", "en": "She is not a child.", "ko": "그녀는 어린이가 아니에요."}, {"j": "私は<em>男です</em>。", "w": ["私", "男"], "zh": "我是男的。", "en": "I am a man.", "ko": "저는 남자예요."}]},
{"i": 1, "bg": "skit-shrine.jpg", "title": {"zh": "コン的家人", "en": "Kon's family", "ko": "콘의 가족"}, "intro": {"zh": "狸太郎想多認識コン,問起他的家人。", "en": "Tanuki wants to know Kon better and asks about his family.", "ko": "타누키가 콘을 더 알고 싶어서 가족에 대해 물어봅니다."}, "start": ["tanuki-bye", "fox-stand"], "end": ["tanuki-yatta", "fox-laugh"], "used": ["家族", "お兄さん", "友達"], "lines": [{"who": "t", "j": "コンさんの家族は、日本に<em>いますか</em>？", "pose": ["tanuki-question", "fox-stand"], "emo": {"t": "?"}, "zh": "コン的家人在日本嗎？", "en": "Is your family in Japan, Kon?", "ko": "콘 씨 가족은 일본에 있어요?", "say": "コンさんの家族は、にほんにいますか？"}, {"who": "k", "j": "はい、<em>います</em>。", "pose": ["tanuki-question", "fox-talk"], "zh": "對,在。", "en": "Yes, they are.", "ko": "네, 있어요."}, {"who": "t", "j": "お兄さんも<em>いますか</em>？", "pose": ["tanuki-bye", "fox-stand"], "zh": "也有哥哥嗎？", "en": "Do you have an older brother too?", "ko": "형도 있어요?"}, {"who": "k", "j": "いいえ、兄は<em>いません</em>。でも、友達が<em>います</em>。", "pose": ["tanuki-surprise", "fox-point"], "emo": {"t": "!"}, "zh": "沒有,我沒有哥哥。不過我有朋友。", "en": "No, I don't have an older brother. But I have a friend.", "ko": "아니요, 형은 없어요. 하지만 친구가 있어요.", "r": "いいえ、あにはいません。でも、ともだちがいます。"}, {"who": "t", "j": "友達…僕ですか！", "pose": ["tanuki-yatta", "fox-laugh"], "emo": {"t": "♪"}, "zh": "朋友……是我嗎！", "en": "A friend… you mean me!", "ko": "친구… 저예요?!"}], "eg": [{"j": "家族は日本に<em>います</em>。", "w": ["家族"], "zh": "家人在日本。", "en": "My family is in Japan.", "ko": "가족은 일본에 있어요."}, {"j": "お兄さんは<em>いません</em>。", "w": ["お兄さん"], "zh": "沒有哥哥。", "en": "There is no older brother.", "ko": "형은 없어요."}, {"j": "友達が<em>います</em>。", "w": ["友達"], "zh": "有朋友。", "en": "I have a friend.", "ko": "친구가 있어요."}]},
{"i": 2, "bg": "skit-bus.jpg", "title": {"zh": "吵鬧的弟弟妹妹", "en": "Noisy little siblings", "ko": "시끄러운 동생들"}, "intro": {"zh": "兩個人搭公車,聊到自己的弟弟妹妹。", "en": "On the bus, the two talk about their younger siblings.", "ko": "버스에서 두 사람이 동생 이야기를 합니다."}, "start": ["tanuki-bye", "fox-stand"], "end": ["tanuki-yatta", "fox-laugh"], "used": ["兄弟", "妹", "弟"], "lines": [{"who": "t", "j": "コンさん、兄弟はいますか？", "pose": ["tanuki-question", "fox-stand"], "emo": {"t": "?"}, "zh": "コン,你有兄弟姊妹嗎？", "en": "Kon, do you have any siblings?", "ko": "콘 씨, 형제가 있어요?"}, {"who": "k", "j": "はい、妹がいます。", "pose": ["tanuki-question", "fox-talk"], "zh": "有,我有妹妹。", "en": "Yes, I have a little sister.", "ko": "네, 여동생이 있어요."}, {"who": "t", "j": "妹さんは<em>元気ですか</em>？", "pose": ["tanuki-bye", "fox-stand"], "zh": "你妹妹有精神嗎？", "en": "Is your sister doing well?", "ko": "여동생은 잘 지내요?"}, {"who": "k", "j": "はい、とても<em>元気です</em>。でも、<em>静かじゃありません</em>。", "pose": ["tanuki-surprise", "fox-sigh"], "emo": {"k": "…"}, "zh": "很有精神。可是一點都不安靜。", "en": "Yes, very. But she's not quiet at all.", "ko": "네, 아주 건강해요. 하지만 조용하지 않아요."}, {"who": "t", "j": "僕の弟も<em>静かじゃありません</em>！", "pose": ["tanuki-yatta", "fox-laugh"], "emo": {"k": "♪"}, "zh": "我弟弟也不安靜！", "en": "My little brother isn't quiet either!", "ko": "제 남동생도 조용하지 않아요!"}], "eg": [{"j": "妹は<em>元気です</em>。", "w": ["妹"], "zh": "妹妹很有精神。", "en": "My little sister is well.", "ko": "여동생은 건강해요."}, {"j": "弟は<em>静かじゃありません</em>。", "w": ["弟"], "zh": "弟弟不安靜。", "en": "My little brother is not quiet.", "ko": "남동생은 조용하지 않아요."}, {"j": "両親は<em>元気です</em>。", "w": ["両親"], "zh": "父母很健康。", "en": "My parents are well.", "ko": "부모님은 건강하세요."}]},
{"i": 3, "bg": "skit-shrine.jpg", "title": {"zh": "溫柔的老師", "en": "A kind teacher", "ko": "상냥한 선생님"}, "intro": {"zh": "コン問狸太郎在日本做什麼。", "en": "Kon asks what Tanuki is doing in Japan.", "ko": "콘이 타누키에게 일본에서 무엇을 하는지 묻습니다."}, "start": ["tanuki-bye", "fox-stand"], "end": ["tanuki-ganbaro", "fox-laugh"], "used": ["学生", "留学生", "先生"], "lines": [{"who": "k", "j": "たぬきさんは、学生ですか？", "pose": ["tanuki-bye", "fox-point"], "emo": {"k": "?"}, "zh": "狸太郎,你是學生嗎？", "en": "Tanuki, are you a student?", "ko": "타누키 씨는 학생이에요?"}, {"who": "t", "j": "はい、留学生です。", "pose": ["tanuki-good", "fox-stand"], "zh": "對,我是留學生。", "en": "Yes, I'm an international student.", "ko": "네, 유학생이에요."}, {"who": "k", "j": "先生は、<em>やさしいですか</em>？", "pose": ["tanuki-good", "fox-talk"], "zh": "老師人好嗎？", "en": "Is your teacher kind?", "ko": "선생님은 상냥해요?"}, {"who": "t", "j": "はい、<em>やさしいです</em>。でも、テストは<em>やさしくないです</em>…", "pose": ["tanuki-cry", "fox-surprise"], "emo": {"t": "…"}, "zh": "老師很溫柔。可是考試一點都不簡單……", "en": "Yes, she's kind. But the tests aren't easy…", "ko": "네, 상냥해요. 하지만 시험은 쉽지 않아요…"}, {"who": "k", "j": "がんばって！", "pose": ["tanuki-ganbaro", "fox-laugh"], "emo": {"k": "♪"}, "zh": "加油！", "en": "Hang in there!", "ko": "힘내요!"}], "eg": [{"j": "先生は<em>やさしいです</em>。", "w": ["先生"], "zh": "老師很溫柔。", "en": "The teacher is kind.", "ko": "선생님은 상냥해요."}, {"j": "医者は<em>忙しいです</em>。", "w": ["医者"], "zh": "醫生很忙。", "en": "The doctor is busy.", "ko": "의사는 바빠요."}, {"j": "留学生は<em>多くないです</em>。", "w": ["留学生"], "zh": "留學生不多。", "en": "There aren't many international students.", "ko": "유학생은 많지 않아요."}]},
{"i": 4, "bg": "skit-ramen.jpg", "title": {"zh": "又是拉麵", "en": "Ramen again", "ko": "또 라멘"}, "intro": {"zh": "拉麵店裡,コン發現狸太郎好像天天來。", "en": "At the ramen shop, Kon notices Tanuki seems to come every day.", "ko": "라멘 가게에서 콘은 타누키가 매일 오는 것 같다는 걸 알아챕니다."}, "start": ["tanuki-ramen", "fox-stand"], "end": ["tanuki-cry", "fox-laugh"], "used": ["今日", "昼", "昨日", "今朝", "明日"], "lines": [{"who": "k", "j": "今日の昼は、ラーメンですか？", "pose": ["tanuki-ramen", "fox-point"], "emo": {"k": "?"}, "zh": "今天中午吃拉麵嗎？", "en": "Ramen for lunch today?", "ko": "오늘 점심은 라멘이에요?"}, {"who": "t", "j": "はい！昨日の昼も、<em>ラーメンでした</em>。", "pose": ["tanuki-yatta", "fox-surprise"], "emo": {"k": "!"}, "zh": "對！昨天中午也是拉麵。", "en": "Yes! Yesterday's lunch was ramen too.", "ko": "네! 어제 점심도 라멘이었어요."}, {"who": "k", "j": "今朝は？", "pose": ["tanuki-ramen", "fox-talk"], "zh": "那今天早上呢？", "en": "And this morning?", "ko": "오늘 아침은요?"}, {"who": "t", "j": "今朝も、<em>ラーメンでした</em>…", "pose": ["tanuki-difficult", "fox-sigh"], "emo": {"k": "…"}, "zh": "今天早上也是拉麵……", "en": "This morning was ramen too…", "ko": "오늘 아침도 라멘이었어요…"}, {"who": "k", "j": "明日は、サラダですね。", "pose": ["tanuki-cry", "fox-smug"], "emo": {"t": "!"}, "zh": "明天就吃沙拉吧。", "en": "Tomorrow it's salad for you.", "ko": "내일은 샐러드네요."}], "eg": [{"j": "昨日は<em>休みでした</em>。", "w": ["昨日"], "zh": "昨天是休假。", "en": "Yesterday was a day off.", "ko": "어제는 휴일이었어요."}, {"j": "今朝は<em>雨でした</em>。", "w": ["今朝"], "zh": "今天早上下雨。", "en": "It was rainy this morning.", "ko": "오늘 아침은 비였어요."}, {"j": "昨日の昼は<em>ラーメンでした</em>。", "w": ["昨日", "昼"], "zh": "昨天中午吃拉麵。", "en": "Yesterday's lunch was ramen.", "ko": "어제 점심은 라멘이었어요."}]},
{"i": 5, "bg": "skit-shrine.jpg", "title": {"zh": "今天早上沒讀書", "en": "Skipped this morning", "ko": "오늘 아침은 안 했어요"}, "intro": {"zh": "コン關心狸太郎的日文學得怎麼樣。", "en": "Kon checks in on how Tanuki's Japanese study is going.", "ko": "콘이 타누키의 일본어 공부가 어떤지 물어봅니다."}, "start": ["tanuki-reading", "fox-stand"], "end": ["tanuki-ganbaro", "fox-laugh"], "used": ["毎日", "毎朝", "夜"], "lines": [{"who": "k", "j": "毎日、日本語を<em>勉強しますか</em>？", "pose": ["tanuki-reading", "fox-point"], "emo": {"k": "?"}, "zh": "你每天都讀日文嗎？", "en": "Do you study Japanese every day?", "ko": "매일 일본어를 공부해요?"}, {"who": "t", "j": "はい！毎朝、<em>勉強します</em>。", "pose": ["tanuki-good", "fox-stand"], "emo": {"t": "♪"}, "zh": "有！我每天早上都讀。", "en": "Yes! I study every morning.", "ko": "네! 매일 아침 공부해요."}, {"who": "k", "j": "今朝も<em>勉強しましたか</em>？", "pose": ["tanuki-surprise", "fox-talk"], "emo": {"t": "!"}, "zh": "今天早上也讀了嗎？", "en": "Did you study this morning too?", "ko": "오늘 아침에도 공부했어요?"}, {"who": "t", "j": "…今朝は<em>勉強しませんでした</em>。", "pose": ["tanuki-difficult", "fox-sigh"], "emo": {"t": "…"}, "zh": "……今天早上沒有讀。", "en": "…I didn't study this morning.", "ko": "…오늘 아침은 공부하지 않았어요."}, {"who": "k", "j": "じゃあ、夜ですね！", "pose": ["tanuki-ganbaro", "fox-laugh"], "emo": {"k": "♪"}, "zh": "那就晚上讀吧！", "en": "Then tonight it is!", "ko": "그럼 밤에 하면 되겠네요!"}], "eg": [{"j": "毎朝、日本語を<em>勉強します</em>。", "w": ["毎朝"], "zh": "每天早上讀日文。", "en": "I study Japanese every morning.", "ko": "매일 아침 일본어를 공부해요."}, {"j": "昨日の夜は<em>勉強しませんでした</em>。", "w": ["夜"], "zh": "昨天晚上沒有讀書。", "en": "I didn't study last night.", "ko": "어젯밤에는 공부하지 않았어요."}, {"j": "先月は毎週、友達に<em>会いました</em>。", "w": ["毎週"], "zh": "上個月每個星期都跟朋友見面。", "en": "Last month I met my friend every week.", "ko": "지난달에는 매주 친구를 만났어요."}]},
{"i": 6, "bg": "skit-shrine.jpg", "title": {"zh": "熱鬧的祭典", "en": "A lively festival", "ko": "북적이는 축제"}, "intro": {"zh": "上星期神社有祭典,狸太郎第一次參加。", "en": "There was a festival at the shrine last week, Tanuki's first.", "ko": "지난주 신사에서 축제가 있었고, 타누키는 처음 가 봤습니다."}, "start": ["tanuki-bye", "fox-stand"], "end": ["tanuki-yatta", "fox-laugh"], "used": ["先週", "去年", "来年"], "lines": [{"who": "k", "j": "先週のお祭りは、どうでしたか？", "pose": ["tanuki-bye", "fox-point"], "emo": {"k": "?"}, "zh": "上星期的祭典怎麼樣？", "en": "How was the festival last week?", "ko": "지난주 축제는 어땠어요?", "kana": "センシュウノ'/オマツリワ'、ド'オデ_シタカ？"}, {"who": "t", "j": "とても<em>にぎやかでした</em>！", "pose": ["tanuki-yatta", "fox-stand"], "emo": {"t": "♪"}, "zh": "非常熱鬧！", "en": "It was really lively!", "ko": "아주 북적였어요!"}, {"who": "k", "j": "去年は、<em>静かでした</em>よ。", "pose": ["tanuki-surprise", "fox-talk"], "emo": {"t": "!"}, "zh": "去年很安靜喔。", "en": "Last year it was quiet, you know.", "ko": "작년에는 조용했어요."}, {"who": "t", "j": "来年も来ます！", "pose": ["tanuki-ganbaro", "fox-surprise"], "zh": "我明年還要來！", "en": "I'm coming next year too!", "ko": "내년에도 올게요!"}, {"who": "k", "j": "じゃあ、来年もいっしょですね。", "pose": ["tanuki-yatta", "fox-laugh"], "emo": {"k": "♪"}, "zh": "那明年也一起去吧。", "en": "Then we'll go together next year too.", "ko": "그럼 내년에도 같이네요."}], "eg": [{"j": "先週は<em>ひまでした</em>。", "w": ["先週"], "zh": "上星期很閒。", "en": "I was free last week.", "ko": "지난주는 한가했어요."}, {"j": "去年のお祭りは<em>静かでした</em>。", "w": ["去年"], "zh": "去年的祭典很安靜。", "en": "Last year's festival was quiet.", "ko": "작년 축제는 조용했어요."}, {"j": "先月は<em>大変でした</em>。", "w": ["先月"], "zh": "上個月很辛苦。", "en": "Last month was tough.", "ko": "지난달은 힘들었어요."}]},
{"i": 7, "bg": "skit-sushi.jpg", "title": {"zh": "生日吃壽司", "en": "Birthday sushi", "ko": "생일 초밥"}, "intro": {"zh": "前天是狸太郎的生日,他去吃了壽司。", "en": "The day before yesterday was Tanuki's birthday, and he had sushi.", "ko": "그저께는 타누키의 생일이라 초밥을 먹었습니다."}, "start": ["tanuki-bye", "fox-stand"], "end": ["tanuki-cry", "fox-laugh"], "used": ["一昨日", "誕生日"], "lines": [{"who": "t", "j": "一昨日は、僕の誕生日でした。", "pose": ["tanuki-good", "fox-surprise"], "emo": {"k": "!"}, "zh": "前天是我的生日。", "en": "The day before yesterday was my birthday.", "ko": "그저께는 제 생일이었어요."}, {"who": "k", "j": "おめでとう！誕生日は、どうでしたか？", "pose": ["tanuki-good", "fox-laugh"], "emo": {"k": "♪"}, "zh": "恭喜！生日過得怎麼樣？", "en": "Congrats! How was your birthday?", "ko": "축하해요! 생일은 어땠어요?"}, {"who": "t", "j": "すしが、とても<em>おいしかったです</em>。", "pose": ["tanuki-yatta", "fox-stand"], "emo": {"t": "♪"}, "zh": "壽司非常好吃。", "en": "The sushi was really delicious.", "ko": "초밥이 아주 맛있었어요."}, {"who": "k", "j": "<em>よかったです</em>ね。", "pose": ["tanuki-yatta", "fox-talk"], "zh": "太好了呢。", "en": "That's great.", "ko": "잘됐네요."}, {"who": "t", "j": "でも、ちょっと<em>高かったです</em>…", "pose": ["tanuki-cry", "fox-laugh"], "emo": {"t": "…"}, "zh": "可是有點貴……", "en": "But it was a bit expensive…", "ko": "하지만 좀 비쌌어요…"}], "eg": [{"j": "誕生日は<em>楽しかったです</em>。", "w": ["誕生日"], "zh": "生日過得很開心。", "en": "My birthday was fun.", "ko": "생일은 즐거웠어요."}, {"j": "月曜日は<em>忙しかったです</em>。", "w": ["月曜日"], "zh": "星期一很忙。", "en": "Monday was busy.", "ko": "월요일은 바빴어요."}, {"j": "休みは<em>短かったです</em>。", "w": ["休み"], "zh": "假期很短。", "en": "The holiday was short.", "ko": "휴가는 짧았어요."}]},
{"i": 8, "bg": "skit-bus.jpg", "title": {"zh": "星期天要不要一起去", "en": "How about Sunday?", "ko": "일요일에 같이 갈래요?"}, "intro": {"zh": "コン想約狸太郎週末出去玩。", "en": "Kon wants to invite Tanuki out for the weekend.", "ko": "콘이 타누키에게 주말에 놀러 가자고 합니다."}, "start": ["tanuki-bye", "fox-stand"], "end": ["tanuki-yatta", "fox-surprise"], "used": ["日曜日", "土曜日"], "lines": [{"who": "k", "j": "たぬきさん、日曜日は休みですか？", "pose": ["tanuki-bye", "fox-point"], "emo": {"k": "?"}, "zh": "狸太郎,你星期天休息嗎？", "en": "Tanuki, are you off on Sunday?", "ko": "타누키 씨, 일요일은 쉬는 날이에요?"}, {"who": "t", "j": "はい、休みです。", "pose": ["tanuki-good", "fox-stand"], "zh": "對,休息。", "en": "Yes, I'm off.", "ko": "네, 쉬는 날이에요."}, {"who": "k", "j": "いっしょに神社へ<em>行きませんか</em>？", "pose": ["tanuki-surprise", "fox-talk"], "emo": {"t": "!"}, "zh": "要不要一起去神社？", "en": "Would you like to go to the shrine together?", "ko": "같이 신사에 가지 않을래요?"}, {"who": "t", "j": "いいですね！土曜日も<em>行きませんか</em>？", "pose": ["tanuki-yatta", "fox-stand"], "emo": {"t": "♪"}, "zh": "好啊！星期六要不要也去？", "en": "Sounds great! How about Saturday too?", "ko": "좋아요! 토요일에도 가지 않을래요?"}, {"who": "k", "j": "土曜日も！？", "pose": ["tanuki-yatta", "fox-surprise"], "emo": {"k": "!"}, "zh": "星期六也去！？", "en": "Saturday too!?", "ko": "토요일에도요!?"}], "eg": [{"j": "日曜日、いっしょに<em>行きませんか</em>。", "w": ["日曜日"], "zh": "星期天要不要一起去？", "en": "Would you like to go together on Sunday?", "ko": "일요일에 같이 가지 않을래요?"}, {"j": "土曜日、映画を<em>見ませんか</em>。", "w": ["土曜日"], "zh": "星期六要不要看電影？", "en": "How about watching a movie on Saturday?", "ko": "토요일에 영화를 보지 않을래요?"}, {"j": "八月に、日本へ<em>来ませんか</em>。", "w": ["八月"], "zh": "八月要不要來日本？", "en": "Won't you come to Japan in August?", "ko": "8월에 일본에 오지 않을래요?"}]},
{"i": 9, "bg": "skit-shrine.jpg", "title": {"zh": "天氣變冷了", "en": "It's getting cold", "ko": "추워졌어요"}, "intro": {"zh": "十月了,楓葉紅了,天氣也變冷了。", "en": "It's October. The leaves have turned red and it's getting cold.", "ko": "10월이 되어 단풍이 들고 날씨도 추워졌습니다."}, "start": ["tanuki-bye", "fox-stand"], "end": ["tanuki-thanks", "fox-laugh"], "used": ["十月", "部屋", "十二月", "うち"], "lines": [{"who": "k", "j": "十月ですね。<em>寒くなりました</em>ね。", "pose": ["tanuki-bye", "fox-talk"], "zh": "十月了呢。變冷了。", "en": "It's October. It's gotten cold, hasn't it?", "ko": "10월이네요. 추워졌네요.", "kana": "ジュウガツ'デ_スネ、サ'ムク/ナリマ'_シタネ"}, {"who": "t", "j": "はい。僕の部屋も<em>寒くなりました</em>。", "pose": ["tanuki-difficult", "fox-stand"], "emo": {"t": "…"}, "zh": "對啊,我的房間也變冷了。", "en": "Yes. My room has gotten cold too.", "ko": "네. 제 방도 추워졌어요.", "kana": "ハ'イ、ボ'クノ/ヘヤ'モ/サ'ムク/ナリマ'_シタ"}, {"who": "k", "j": "十二月は、もっと<em>寒くなります</em>よ。", "pose": ["tanuki-difficult", "fox-smug"], "zh": "十二月會更冷喔。", "en": "It gets even colder in December.", "ko": "12월에는 더 추워져요.", "kana": "ジュウニガツ'ワ、モ'ット/サ'ムク/ナリマ'_スヨ"}, {"who": "t", "j": "えっ！", "pose": ["tanuki-surprise", "fox-laugh"], "emo": {"t": "!"}, "zh": "咦！", "en": "What!", "ko": "네?!"}, {"who": "k", "j": "うちへ来ませんか？あたたかいですよ。", "pose": ["tanuki-thanks", "fox-point"], "emo": {"t": "♪"}, "zh": "要不要來我家？很暖和喔。", "en": "Why not come to my place? It's warm.", "ko": "우리 집에 오지 않을래요? 따뜻해요."}], "eg": [{"j": "部屋が<em>寒くなりました</em>。", "w": ["部屋"], "zh": "房間變冷了。", "en": "The room has gotten cold.", "ko": "방이 추워졌어요."}, {"j": "十二月は<em>寒くなります</em>。", "w": ["十二月"], "zh": "十二月會變冷。", "en": "It gets cold in December.", "ko": "12월에는 추워져요."}, {"j": "部屋が<em>きれいになりました</em>。", "w": ["部屋"], "zh": "房間變乾淨了。", "en": "The room has become clean.", "ko": "방이 깨끗해졌어요."}]}
]
